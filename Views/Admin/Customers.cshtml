@model IEnumerable<Wedside_TVS_SFX.ViewModels.Admin.B2BCustomerListItemViewModel>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";

    var totalCustomers = ViewBag.TotalCustomers ?? Model.Count();
    var totalVip = ViewBag.TotalVip ?? Model.Count(x => x.NhomB2B == "VIP");
    var totalSales = ViewBag.TotalSales ?? Model.Sum(x => x.TongChiTieu);
}

@section styles {
    <!-- Nạp trực tiếp CSS của trang Sản Phẩm để đồng bộ 100% giao diện Dark Mode -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/admin/admin-products.css")" />

    <style>
        /* Mở rộng CSS Modal và Badges chuẩn STAGEFX PRO */
        .product-status.vip {
            background-color: rgba(229, 9, 20, 0.15);
            color: #e50914;
            border: 1px solid rgba(229, 9, 20, 0.3);
        }

        .product-status.gold {
            background-color: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .product-status.silver {
            background-color: rgba(148, 163, 184, 0.15);
            color: #94a3b8;
            border: 1px solid rgba(148, 163, 184, 0.3);
        }

        /* Popup Modal chuẩn tông đen STAGEFX */
        .sf-modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            backdrop-filter: blur(5px);
        }

        .sf-modal-card {
            background: #121217;
            border: 1px solid #22222e;
            border-radius: 8px;
            width: 100%;
            max-width: 580px;
            padding: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }

        .sf-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            border-bottom: 1px solid #22222e;
            padding-bottom: 14px;
        }

            .sf-modal-header h3 {
                color: #ffffff;
                font-size: 18px;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .sf-form-group {
            margin-bottom: 16px;
        }

            .sf-form-group label {
                display: block;
                color: #8f8fa8;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 6px;
            }

        .sf-input {
            width: 100%;
            background: #09090d;
            border: 1px solid #282838;
            border-radius: 6px;
            padding: 10px 14px;
            color: #ffffff;
            font-size: 13px;
            outline: none;
            box-sizing: border-box;
            transition: all 0.2s;
        }

            .sf-input:focus {
                border-color: #e50914;
                box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.2);
            }

        .sf-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid #22222e;
        }
    </style>
}

<div class="admin-products">

    <!-- PAGE HEADER -->
    <div class="products-page-header">
        <div class="products-page-heading">
            <span class="products-eyebrow">CUSTOMER MANAGEMENT / B2B</span>
            <h1>Quản lý khách hàng</h1>
            <p>Quản lý danh mục đối tác kinh doanh, tự động phân cấp ưu đãi và theo dõi chi tiêu.</p>
        </div>

        <div class="products-header-icon">
            <span class="material-symbols-outlined">group</span>
            <span>Hệ thống khách hàng</span>

            <button type="button" class="products-add-btn" onclick="openCreateModal()">
                <span class="material-symbols-outlined">add</span>
                Thêm khách hàng
            </button>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="products-stats">

        <div class="product-stat-card">
            <div class="product-stat-icon">
                <span class="material-symbols-outlined">group</span>
            </div>
            <div>
                <span>Tổng khách hàng</span>
                <strong>@totalCustomers.ToString("N0")</strong>
            </div>
        </div>

        <div class="product-stat-card">
            <div class="product-stat-icon active">
                <span class="material-symbols-outlined">workspace_premium</span>
            </div>
            <div>
                <span>Đối tác VIP (≥50Tr)</span>
                <strong>@totalVip.ToString("N0")</strong>
            </div>
        </div>

        <div class="product-stat-card">
            <div class="product-stat-icon warning">
                <span class="material-symbols-outlined">payments</span>
            </div>
            <div>
                <span>Tổng chi tiêu tích lũy</span>
                <strong>@totalSales.ToString("N0") ₫</strong>
            </div>
        </div>

    </div>

    <!-- PRODUCT CONTENT -->
    <div class="products-content-card">

        <!-- CONTENT HEADER -->
        <div class="products-content-heading">
            <div>
                <h2>Danh sách khách hàng B2B</h2>
                <p>Tra cứu thông tin liên hệ, phân cấp chiết khấu và lịch sử đặt hàng sân khấu.</p>
            </div>

            <span class="products-total">
                @Model.Count().ToString("N0") khách hàng
            </span>
        </div>

        <!-- SEARCH AND FILTER -->
        <div class="products-filter-form" id="customerFilterForm">

            <div class="products-search">
                <span class="material-symbols-outlined">search</span>

                <input type="text"
                       id="productSearch"
                       placeholder="Tìm tên khách hàng, email, SĐT hoặc mã KH..."
                       autocomplete="off"
                       onkeyup="filterTable()" />

                <button type="button"
                        id="clearProductSearch"
                        title="Xóa từ khóa"
                        onclick="clearSearch()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="products-filter">

                <!-- TIER FILTER -->
                <select id="tierFilter" aria-label="Lọc theo hạng ưu đãi" onchange="filterTable()">
                    <option value="">Tất cả hạng ưu đãi</option>
                    <option value="VIP">B2B VIP (-15%)</option>
                    <option value="Gold">B2B Vàng (-10%)</option>
                    <option value="Silver">B2B Bạc (-5%)</option>
                </select>

                <button type="button" class="products-filter-btn" onclick="filterTable()">
                    <span class="material-symbols-outlined">filter_alt</span>
                    Lọc
                </button>

                <button type="button" class="products-reset-btn" onclick="resetFilters()">
                    <span class="material-symbols-outlined">restart_alt</span>
                    Đặt lại
                </button>

            </div>
        </div>

        <!-- TABLE -->
        <div class="products-table-wrapper">

            <table class="products-table" id="customerTable">

                <thead>
                    <tr>
                        <th>KHÁCH HÀNG</th>
                        <th>THÔNG TIN LIÊN HỆ</th>
                        <th>HẠNG B2B</th>
                        <th>CHIẾT KHẤU</th>
                        <th>ĐƠN HÀNG</th>
                        <th>TỔNG CHI TIÊU</th>
                        <th>TRẠNG THÁI</th>
                        <th>THAO TÁC</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- CUSTOMER NAME & CODE -->
                                <td>
                                    <strong class="product-name">
                                        @item.HoTen
                                    </strong>
                                    <small class="product-sku">
                                        Mã KH: KH-@item.MaNguoiDung
                                    </small>
                                </td>

                                <!-- CONTACT -->
                                <td>
                                    <span class="product-category">
                                        @item.SoDienThoai
                                    </span>
                                    <small class="product-sku" style="display:block;">
                                        @item.Email
                                    </small>
                                </td>

                                <!-- TIER BADGE -->
                                <td>
                                    @if (item.NhomB2B == "VIP")
                                    {
                                        <span class="product-status vip">
                                            VIP
                                        </span>
                                    }
                                    else if (item.NhomB2B == "Gold")
                                    {
                                        <span class="product-status gold">
                                            Vàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status silver">
                                            Bạc
                                        </span>
                                    }
                                </td>

                                <!-- DISCOUNT -->
                                <td>
                                    <strong class="product-price" style="color: #e50914;">
                                        -@item.PhanTramChietKhau%
                                    </strong>
                                </td>

                                <!-- ORDERS COUNT -->
                                <td>
                                    <span class="product-stock">
                                        @item.TongDonHang đơn
                                    </span>
                                </td>

                                <!-- TOTAL SPENT -->
                                <td>
                                    <strong class="product-price">
                                        @item.TongChiTieu.ToString("N0") ₫
                                    </strong>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="product-status active">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status inactive">
                                            Đã khóa
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td class="product-actions">

                                    <!-- EDIT -->
                                    <button type="button"
                                            class="product-action-btn edit"
                                            title="Chỉnh sửa"
                                            onclick="editCustomer(@item.MaNguoiDung)">
                                        <span class="material-symbols-outlined">edit</span>
                                        Sửa
                                    </button>

                                    <!-- HISTORY -->
                                    <button type="button"
                                            class="product-action-btn view"
                                            title="Lịch sử mua hàng"
                                            onclick="viewHistory(@item.MaNguoiDung)">
                                        <span class="material-symbols-outlined">history</span>
                                        Lịch sử
                                    </button>

                                    <!-- TOGGLE STATUS -->
                                    @if (item.TrangThai)
                                    {
                                        <button type="button"
                                                class="product-action-btn disable"
                                                title="Khóa tài khoản"
                                                onclick="toggleStatus(@item.MaNguoiDung)">
                                            <span class="material-symbols-outlined">lock</span>
                                            Khóa
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="product-action-btn enable"
                                                title="Mở khóa tài khoản"
                                                onclick="toggleStatus(@item.MaNguoiDung)">
                                            <span class="material-symbols-outlined">lock_open</span>
                                            Mở khóa
                                        </button>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="products-empty">
                                    <span class="material-symbols-outlined">
                                        group_off
                                    </span>

                                    <h3>Không tìm thấy khách hàng</h3>
                                    <p>Thử thay đổi từ khóa hoặc điều kiện lọc.</p>

                                    <button type="button" class="products-reset-btn" onclick="resetFilters()">
                                        Xem tất cả khách hàng
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>

        <!-- FOOTER INFO -->
        <div class="products-pagination">
            <span class="pagination-info">
                Hiển thị <strong>@Model.Count()</strong> khách hàng B2B
            </span>
        </div>

    </div>
</div>

<!-- MODAL: THÊM / SỬA KHÁCH HÀNG -->
<div class="sf-modal-backdrop" id="customerFormModal">
    <div class="sf-modal-card">
        <div class="sf-modal-header">
            <h3 id="modalTitle">
                <span class="material-symbols-outlined" style="color:#e50914;">person_add</span>
                Thêm mới khách hàng B2B
            </h3>
            <button type="button" class="product-action-btn edit" style="padding: 4px;" onclick="closeModal('customerFormModal')">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="customerForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="MaNguoiDung" name="MaNguoiDung" value="0" />

            <div class="sf-form-group">
                <label>Họ và tên <span style="color:#e50914;">*</span></label>
                <input type="text" id="HoTen" name="HoTen" class="sf-input" placeholder="Nhập họ tên đối tác..." required />
            </div>

            <div class="sf-form-group">
                <label>Địa chỉ Email <span style="color:#e50914;">*</span></label>
                <input type="email" id="Email" name="Email" class="sf-input" placeholder="nhanvien@congty.com" required />
            </div>

            <div class="sf-form-group">
                <label>Số điện thoại</label>
                <input type="text" id="SoDienThoai" name="SoDienThoai" class="sf-input" placeholder="0901234567" />
            </div>

            <div class="sf-form-group">
                <label>Trạng thái tài khoản</label>
                <select id="TrangThai" name="TrangThai" class="sf-input">
                    <option value="true">Hoạt động (Bình thường)</option>
                    <option value="false">Tạm khóa tài khoản</option>
                </select>
            </div>

            <div class="sf-modal-actions">
                <button type="button" class="products-reset-btn" onclick="closeModal('customerFormModal')">Hủy bỏ</button>
                <button type="button" class="products-add-btn" onclick="submitCustomerForm()">
                    <span class="material-symbols-outlined">save</span>
                    Lưu thông tin
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: LỊCH SỬ MUA HÀNG -->
<div class="sf-modal-backdrop" id="historyModal">
    <div class="sf-modal-card" style="max-width: 700px;">
        <div class="sf-modal-header">
            <h3>
                <span class="material-symbols-outlined" style="color:#e50914;">history</span>
                Lịch sử mua thiết bị: <span id="historyCustomerName" style="color:#e50914;"></span>
            </h3>
            <button type="button" class="product-action-btn edit" style="padding: 4px;" onclick="closeModal('historyModal')">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
            <div style="background: #09090d; padding: 14px; border-radius: 6px; border: 1px solid #22222e;">
                <span style="color:#72728a; font-size: 11px; font-weight:700; text-transform:uppercase;">TỔNG ĐƠN ĐÃ MUA</span>
                <div id="historyTotalOrders" style="font-size: 20px; font-weight: 800; color: #ffffff; margin-top: 4px;">0 đơn</div>
            </div>
            <div style="background: #09090d; padding: 14px; border-radius: 6px; border: 1px solid #22222e;">
                <span style="color:#72728a; font-size: 11px; font-weight:700; text-transform:uppercase;">TỔNG GIÁ TRỊ CHI TIÊU</span>
                <div id="historyTotalSpent" style="font-size: 20px; font-weight: 800; color: #10b981; margin-top: 4px;">0 ₫</div>
            </div>
        </div>

        <div class="products-table-wrapper" style="max-height: 360px; overflow-y: auto;">
            <table class="products-table">
                <thead>
                    <tr>
                        <th>MÃ ĐƠN HÀNG</th>
                        <th>SẢN PHẨM MUA</th>
                        <th>SL</th>
                        <th>THÀNH TIỀN</th>
                        <th>NGÀY ĐẶT</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody"></tbody>
            </table>
        </div>

        <div class="sf-modal-actions">
            <button type="button" class="products-reset-btn" onclick="closeModal('historyModal')">Đóng</button>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <script>
        function openCreateModal() {
            $('#customerForm')[0].reset();
            $('#MaNguoiDung').val(0);
            $('#modalTitle').html('<span class="material-symbols-outlined" style="color:#e50914;">person_add</span> Thêm mới khách hàng B2B');
            $('#customerFormModal').css('display', 'flex');
        }

        function closeModal(id) {
            $('#' + id).css('display', 'none');
        }

        function submitCustomerForm() {
            var formData = $('#customerForm').serialize();
            $.post('/AdminCustomer/SaveCustomer', formData, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('Có lỗi xảy ra khi kết nối hệ thống!');
            });
        }

        function editCustomer(id) {
            $.get('/AdminCustomer/GetCustomerDetail', { id: id }, function (data) {
                if (!data) return;
                $('#MaNguoiDung').val(data.maNguoiDung);
                $('#HoTen').val(data.hoTen);
                $('#Email').val(data.email);
                $('#SoDienThoai').val(data.soDienThoai);
                $('#TrangThai').val(data.trangThai ? "true" : "false");
                $('#modalTitle').html('<span class="material-symbols-outlined" style="color:#e50914;">edit</span> Cập nhật thông tin khách hàng');
                $('#customerFormModal').css('display', 'flex');
            });
        }

        function toggleStatus(id) {
            if (confirm("Bạn có chắc chắn muốn khóa / mở khóa tài khoản này?")) {
                $.post('/AdminCustomer/ToggleStatus', { id: id }, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }

        function viewHistory(maNguoiDung) {
            $.get('/AdminCustomer/GetOrderHistory', { maNguoiDung: maNguoiDung }, function (res) {
                if (!res) return;
                $('#historyCustomerName').text(res.HoTen);
                $('#historyTotalOrders').text(res.TongDonHang + ' đơn');
                $('#historyTotalSpent').text(res.TongChiTieu.toLocaleString('vi-VN') + ' ₫');

                var html = '';
                if (!res.DanhSachDonHang || res.DanhSachDonHang.length === 0) {
                    html = '<tr><td colspan="5" style="text-align:center; color:#72728a; padding: 24px;">Chưa có lịch sử đơn hàng.</td></tr>';
                } else {
                    $.each(res.DanhSachDonHang, function (i, item) {
                        html += `<tr>
                                <td><div class="product-code">#${item.MaSoDonHang}</div></td>
                                <td><strong class="product-name">${item.TenSanPham}</strong></td>
                                <td>x${item.SoLuong}</td>
                                <td><strong class="product-price">${item.ThanhTien.toLocaleString('vi-VN')} ₫</strong></td>
                                <td><span class="product-date">${new Date(parseInt(item.NgayDat.replace('/Date(', ''))).toLocaleDateString('vi-VN')}</span></td>
                            </tr>`;
                    });
                }
                $('#historyTableBody').html(html);
                $('#historyModal').css('display', 'flex');
            });
        }

        function filterTable() {
            var search = $('#productSearch').val().toLowerCase().trim();
            var tier = $('#tierFilter').val().toLowerCase();

            $('#customerTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                var matchesSearch = text.indexOf(search) > -1;
                var matchesTier = !tier || text.indexOf(tier) > -1;

                if (matchesSearch && matchesTier) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function clearSearch() {
            $('#productSearch').val('');
            filterTable();
        }

        function resetFilters() {
            $('#productSearch').val('');
            $('#tierFilter').val('');
            filterTable();
        }
    </script>
}
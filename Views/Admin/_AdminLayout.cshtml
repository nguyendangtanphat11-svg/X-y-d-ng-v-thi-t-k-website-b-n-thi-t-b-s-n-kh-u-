@using System
@using System.Web
@using System.Web.Mvc

@{
    // =====================================================
    // 01. PAGE INFORMATION
    // =====================================================

    string pageTitle = ViewBag.Title as string ?? "Bảng điều khiển";

    string currentController =
        ViewContext.RouteData.Values["controller"] as string ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"] as string ?? "";

    // =====================================================
    // 02. CURRENT USER INFORMATION
    // =====================================================

    string currentUserName =
        Session["HoTen"] as string ?? "Administrator";

    string currentUserEmail =
        Session["Email"] as string ?? "";

    string currentRole =
        Session["TenVaiTro"] as string ?? "ADMINISTRATOR";

    int currentRoleId = 0;

    int.TryParse(
        Convert.ToString(Session["MaVaiTro"]),
        out currentRoleId
    );

    // Chỉ tài khoản có MaVaiTro = 1 mới được hiển thị mục Admin.
    bool isAdminAccount = currentRoleId == 1;

    string avatarLetter = string.IsNullOrWhiteSpace(currentUserName)
        ? "A"
        : currentUserName.Substring(0, 1).ToUpperInvariant();

    // =====================================================
    // 03. ROUTE HELPERS
    // =====================================================

    Func<string, bool> isController = controller =>
        string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase
        );

    Func<string, bool> isAction = action =>
        string.Equals(
            currentAction,
            action,
            StringComparison.OrdinalIgnoreCase
        );

    // =====================================================
    // 04. SIDEBAR ACTIVE STATES
    // =====================================================

    bool isDashboardActive =
        isController("Admin") && isAction("Index");

    bool isOrdersActive =
        isController("AdminOrder");

    bool isProductsActive =
        isController("AdminProduct");

    bool isCategoriesActive =
        isController("AdminCategory");

    bool isInventoryActive =
        isController("AdminInventory");

    bool isInventoryListActive =
        isInventoryActive && isAction("Inventory");

    bool isInventoryHistoryActive =
        isInventoryActive && isAction("History");

    bool isCustomersActive =
        isController("AdminCustomer");

    bool isConsultationsActive =
        isController("AdminConsultation");

    bool isReviewsActive =
        isController("AdminReview");

    bool isPromotionsActive =
        isController("AdminPromotion");

    bool isReportsActive =
        isController("AdminReport");

    // =====================================================
    // 05. COMING SOON PARTIAL HELPER
    // =====================================================

    Func<string, string, IHtmlString> comingSoon = (icon, text) =>
    {
        var partialViewData = new ViewDataDictionary(ViewData);

        partialViewData["Icon"] = icon;
        partialViewData["Text"] = text;

        return Html.Partial(
            "~/Views/Admin/_AdminComingSoonItem.cshtml",
            null,
            partialViewData
        );
    };
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#090909" />

    <title>@pageTitle - STAGEFX PRO Admin</title>

    <!-- =================================================
         GOOGLE FONTS
    ================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;600&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
          rel="stylesheet" />

    <!-- =================================================
         ADMIN STYLES
    ================================================== -->

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/admin/admin-layout.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/admin/admin-sidebar.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/admin/admin-header.css")" />

    @RenderSection("styles", required: false)

</head>

<body class="admin-shell">

    <!-- =================================================
         SIDEBAR BACKDROP
    ================================================== -->

    <div class="admin-shell-backdrop"
         data-admin-sidebar-close
         aria-hidden="true">
    </div>

    <!-- =================================================
         SIDEBAR
    ================================================== -->

    <aside class="admin-sidebar"
           id="admin-sidebar"
           aria-label="Điều hướng quản trị">

        <!-- BRAND -->

        <div class="admin-sidebar-brand">

            <a href="@Url.Action("Index", "Admin")"
               class="admin-brand-link"
               aria-label="STAGEFX PRO - Bảng điều khiển">

                <span class="admin-brand-mark">
                    S
                </span>

                <span class="admin-brand-copy">

                    <strong>
                        STAGEFX <b>PRO</b>
                    </strong>

                    <small>
                        ADMINISTRATOR PANEL
                    </small>

                </span>

            </a>

            <button type="button"
                    class="admin-mobile-close"
                    data-admin-sidebar-close
                    aria-label="Đóng menu">

                <span class="material-symbols-outlined"
                      aria-hidden="true">
                    close
                </span>

            </button>

        </div>

        <!-- =================================================
             NAVIGATION
        ================================================== -->

        <nav class="admin-navigation"
             aria-label="Menu quản trị">

            <!-- OVERVIEW -->

            <div class="admin-nav-group">

                <span class="admin-nav-label">
                    OVERVIEW
                </span>

                <a href="@Url.Action("Index", "Admin")"
                   class="admin-nav-item @(isDashboardActive ? "is-active" : "")"
                   aria-current="@(isDashboardActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        dashboard
                    </span>

                    <span class="admin-nav-text">
                        Dashboard
                    </span>

                </a>

            </div>

            <!-- BUSINESS MANAGEMENT -->

            <div class="admin-nav-group">

                <span class="admin-nav-label">
                    BUSINESS MANAGEMENT
                </span>

                <!-- ORDERS -->

                <a href="@Url.Action("Orders", "AdminOrder")"
                   class="admin-nav-item @(isOrdersActive ? "is-active" : "")"
                   aria-current="@(isOrdersActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        receipt_long
                    </span>

                    <span class="admin-nav-text">
                        Đơn hàng
                    </span>

                </a>

                <!-- PRODUCTS -->

                <a href="@Url.Action("Products", "AdminProduct")"
                   class="admin-nav-item @(isProductsActive ? "is-active" : "")"
                   aria-current="@(isProductsActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        inventory_2
                    </span>

                    <span class="admin-nav-text">
                        Sản phẩm
                    </span>

                </a>

                <!-- CATEGORIES -->

                <a href="@Url.Action("Categories", "AdminCategory")"
                   class="admin-nav-item @(isCategoriesActive ? "is-active" : "")"
                   aria-current="@(isCategoriesActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        category
                    </span>

                    <span class="admin-nav-text">
                        Danh mục
                    </span>

                </a>

                <!-- INVENTORY -->

                <a href="@Url.Action("Inventory", "AdminInventory")"
                   class="admin-nav-item @(isInventoryListActive ? "is-active" : "")"
                   aria-current="@(isInventoryListActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        warehouse
                    </span>

                    <span class="admin-nav-text">
                        Kho hàng
                    </span>

                </a>

                <!-- INVENTORY HISTORY -->

                <a href="@Url.Action("History", "AdminInventory")"
                   class="admin-nav-item @(isInventoryHistoryActive ? "is-active" : "")"
                   aria-current="@(isInventoryHistoryActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        history
                    </span>

                    <span class="admin-nav-text">
                        Lịch sử kho
                    </span>

                </a>

                <!-- PROMOTIONS -->

                <a href="@Url.Action("Promotions", "AdminPromotion")"
                   class="admin-nav-item @(isPromotionsActive ? "is-active" : "")"
                   aria-current="@(isPromotionsActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        local_offer
                    </span>

                    <span class="admin-nav-text">
                        Khuyến mãi
                    </span>

                </a>

            </div>

            <!-- CUSTOMER MANAGEMENT -->

            <div class="admin-nav-group">

                <span class="admin-nav-label">
                    CUSTOMER MANAGEMENT
                </span>

                <!-- B2B CUSTOMERS -->

                <a href="@Url.Action("Index", "AdminCustomer")"
                   class="admin-nav-item @(isCustomersActive ? "is-active" : "")"
                   aria-current="@(isCustomersActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        group
                    </span>

                    <span class="admin-nav-text">
                        Khách hàng B2B
                    </span>

                </a>

                <!-- CONSULTATIONS -->

                <a href="@Url.Action("Consultations", "AdminConsultation")"
                   class="admin-nav-item @(isConsultationsActive ? "is-active" : "")"
                   aria-current="@(isConsultationsActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        support_agent
                    </span>

                    <span class="admin-nav-text">
                        Yêu cầu tư vấn
                    </span>

                </a>

                <!-- REVIEWS -->

                <a href="@Url.Action("Reviews", "AdminReview")"
                   class="admin-nav-item @(isReviewsActive ? "is-active" : "")"
                   aria-current="@(isReviewsActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        rate_review
                    </span>

                    <span class="admin-nav-text">
                        Đánh giá sản phẩm
                    </span>

                </a>

            </div>

            <!-- REPORTS & SYSTEM -->

            <div class="admin-nav-group">

                <span class="admin-nav-label">
                    REPORTS &amp; SYSTEM
                </span>

                <!-- REPORTS -->

                <a href="@Url.Action("Reports", "AdminReport")"
                   class="admin-nav-item @(isReportsActive ? "is-active" : "")"
                   aria-current="@(isReportsActive ? "page" : null)">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        monitoring
                    </span>

                    <span class="admin-nav-text">
                        Báo cáo &amp; Thống kê
                    </span>

                </a>

            </div>

        </nav>

        <!-- =================================================
             SIDEBAR FOOTER
        ================================================== -->

        <div class="admin-sidebar-footer">

            <span class="admin-status-dot"
                  aria-hidden="true">
            </span>

            <span>
                Hệ thống hoạt động
            </span>

        </div>

    </aside>

    <!-- =================================================
         MAIN CONTENT
    ================================================== -->

    <div class="admin-shell-content">

        <!-- HEADER -->

        <header class="admin-header">

            <div class="admin-header-left">

                <!-- SIDEBAR TOGGLE -->

                <button type="button"
                        class="admin-sidebar-toggle"
                        data-admin-sidebar-toggle
                        aria-expanded="true"
                        aria-controls="admin-sidebar"
                        aria-label="Thu gọn menu">

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        menu
                    </span>

                </button>

                <!-- BREADCRUMB -->

                <div class="admin-breadcrumb"
                     aria-label="Breadcrumb">

                    <span>
                        Admin
                    </span>

                    <span class="material-symbols-outlined"
                          aria-hidden="true">
                        chevron_right
                    </span>

                    <strong>
                        @pageTitle
                    </strong>

                </div>

            </div>

            <div class="admin-header-right">

                <!-- CURRENT PAGE -->

                <div class="admin-current-page">

                    <span class="admin-current-page-label">
                        TRANG HIỆN TẠI
                    </span>

                    <strong>
                        @pageTitle
                    </strong>

                </div>

                <!-- =================================================
                     ACCOUNT MENU
                ================================================== -->

                <div class="admin-account"
                     data-admin-account>

                    <button type="button"
                            class="admin-account-toggle"
                            data-admin-account-toggle
                            aria-expanded="false"
                            aria-controls="admin-account-menu">

                        <span class="admin-account-avatar"
                              aria-hidden="true">
                            @avatarLetter
                        </span>

                        <span class="admin-account-details">

                            <strong>
                                @currentUserName
                            </strong>

                            <small>
                                @currentRole
                            </small>

                        </span>

                        <span class="material-symbols-outlined admin-account-chevron"
                              aria-hidden="true">
                            expand_more
                        </span>

                    </button>

                    <!-- ACCOUNT DROPDOWN -->

                    <div class="admin-account-menu"
                         id="admin-account-menu"
                         hidden>

                        <!-- USER INFORMATION -->

                        <div class="admin-account-menu-user">

                            <strong>
                                @currentUserName
                            </strong>

                            <span>
                                @currentUserEmail
                            </span>

                            <small>
                                @currentRole
                            </small>

                        </div>

                        <div class="admin-account-divider"></div>

                        <!-- CUSTOMER WEBSITE -->

                        <a href="@Url.Action("Index", "Home")"
                           class="admin-account-menu-item">

                            <span class="material-symbols-outlined"
                                  aria-hidden="true">
                                language
                            </span>

                            <span>
                                Trang người dùng
                            </span>

                        </a>


                        <div class="admin-account-divider"></div>

                        <!-- PROFILE -->

                        <a href="@Url.Action("Profile", "Account")"
                           class="admin-account-menu-item">

                            <span class="material-symbols-outlined"
                                  aria-hidden="true">
                                person
                            </span>

                            <span>
                                Thông tin tài khoản
                            </span>

                        </a>

                        <!-- LOGOUT -->

                        <a href="@Url.Action("Logout", "Account")"
                           class="admin-account-menu-item admin-logout-link">

                            <span class="material-symbols-outlined"
                                  aria-hidden="true">
                                logout
                            </span>

                            <span>
                                Đăng xuất
                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </header>

        <!-- =================================================
             PAGE CONTENT
        ================================================== -->

        <main class="admin-main"
              id="admin-main-content">

            @RenderBody()

        </main>

        <!-- =================================================
             FOOTER
        ================================================== -->

        <footer class="admin-footer">

            <span>
                STAGEFX PRO
            </span>

            <span>
                Admin panel v1.0
            </span>

            <span>
                &copy; @DateTime.Now.Year
            </span>

        </footer>

    </div>

    <!-- =================================================
         JAVASCRIPT
    ================================================== -->

    <script src="@Url.Content("~/Scripts/admin/admin-layout.js")"
            defer></script>

    @RenderSection("scripts", required: false)

</body>
</html>
```
@using System

@{
    string pageTitle = ViewBag.Title as string ?? "Bảng điều khiển";

    string currentController =
        ViewContext.RouteData.Values["controller"] as string ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"] as string ?? "";

    string currentUserName =
        Session["HoTen"] as string ?? "Administrator";

    string currentUserEmail =
        Session["Email"] as string ?? "";

    string currentRole =
        Session["TenVaiTro"] as string ?? "ADMINISTRATOR";

    Func<string, bool> isController = controller =>
        string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase);

    Func<string, bool> isAction = action =>
        string.Equals(
            currentAction,
            action,
            StringComparison.OrdinalIgnoreCase);

    bool isDashboardActive =
        isController("Admin") && isAction("Index");

    bool isOrdersActive =
        isController("AdminOrder");

    bool isProductsActive =
        isController("AdminProduct");

    bool isCustomersActive =
        isController("AdminCustomer");

    bool isInventoryActive =
        isController("AdminInventory");

    bool isInventoryListActive =
        isInventoryActive && isAction("Inventory");

    bool isInventoryHistoryActive =
        isInventoryActive && isAction("History");

    string avatarLetter =
        string.IsNullOrWhiteSpace(currentUserName)
            ? "A"
            : currentUserName.Substring(0, 1).ToUpperInvariant();

    // Partial View dùng chung cho các chức năng đang phát triển.
    Func<string, string, IHtmlString> comingSoon = (icon, text) =>
    {
        var partialViewData =
            new ViewDataDictionary(ViewData);

        partialViewData["Icon"] = icon;
        partialViewData["Text"] = text;

        return Html.Partial(
            "~/Views/Admin/_AdminComingSoonItem.cshtml",
            null,
            partialViewData);
    };
}



@model STAGEFX_PRO.ViewModels.HomeViewModel

@using System
@using System.Linq

@{
    ViewBag.Title = "STAGEFX PRO | Giải pháp hiệu ứng sân khấu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = Model.Categories;
    var products = Model.Products;

    Func<string, string> getCategoryType = name =>
    {
        var value = (name ?? "").ToLowerInvariant();

        if (value.Contains("lửa") || value.Contains("flame"))
            return "flame";

        if (value.Contains("khói") || value.Contains("haze") || value.Contains("fog"))
            return "fog";

        if (value.Contains("spark"))
            return "spark";

        if (value.Contains("co2"))
            return "co2";

        if (value.Contains("giấy") || value.Contains("confetti"))
            return "confetti";

        return "control";
    };

    Func<string, string> getProductType = name =>
    {
        var type = getCategoryType(name);

        if (type == "flame" || type == "fog" || type == "co2")
            return type;

        return "haze";
    };
}

<main id="home">


    <!-- ==========================================
         01. HERO
    =========================================== -->
    <section class="hero" id="trang-chu">

        <!-- HERO VIDEO BACKGROUND -->
        <video class="hero-video"
               autoplay
               muted
               loop
               playsinline
               preload="metadata"
               poster="@Url.Content("~/Content/images/banner-fallback.jpg")">

            <source src="@Url.Content("~/Content/videos/stage-banner.mp4")"
                    type="video/mp4" />

            Trình duyệt không hỗ trợ video.
        </video>

        <div class="hero-scrim"></div>

        <div class="container hero-content">

            <div class="status-pill">
                <i></i>
                <span>STAGEFX PRO</span>
                <span>|</span>
                <span>PROFESSIONAL STAGE SOLUTIONS</span>
            </div>

            <h1>
                GIẢI PHÁP HIỆU ỨNG
                <em>SÂN KHẤU CHUYÊN NGHIỆP</em>
            </h1>

            <p class="hero-copy">
                Cung cấp thiết bị hiệu ứng sân khấu và giải pháp kỹ thuật
                dành cho công ty tổ chức sự kiện, đơn vị sản xuất chương trình
                và nhà thầu sân khấu trên toàn quốc.
            </p>

            <div class="hero-actions">

                <button type="button"
                        class="btn btn-primary"
                        data-scroll="#danh-muc">
                    Khám phá thiết bị
                    <span>→</span>
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-scroll="#tu-van">
                    <span class="material-symbols-outlined">
                        support_agent
                    </span>
                    Nhận tư vấn B2B
                </button>

                <span class="cert-note">
                    <span class="material-symbols-outlined">
                        verified_user
                    </span>
                    Tư vấn hồ sơ kỹ thuật và an toàn
                </span>

            </div>

            <!-- HERO STATS -->
            <div class="stats">

                <div class="stat">
                    <span class="material-symbols-outlined red">
                        stadium
                    </span>
                    <div>
                        <strong>500+</strong>
                        <small>Dự án sự kiện tham khảo</small>
                    </div>
                </div>

                <div class="stat">
                    <span class="material-symbols-outlined green">
                        verified
                    </span>
                    <div>
                        <strong>CE / RoHS</strong>
                        <small>Tiêu chuẩn thiết bị theo hồ sơ</small>
                    </div>
                </div>

                <div class="stat">
                    <span class="material-symbols-outlined peach">
                        engineering
                    </span>
                    <div>
                        <strong>Technical</strong>
                        <small>Hỗ trợ tư vấn kỹ thuật</small>
                    </div>
                </div>

                <div class="stat">
                    <span class="material-symbols-outlined red">
                        settings_remote
                    </span>
                    <div>
                        <strong>DMX512</strong>
                        <small>Giải pháp điều khiển sân khấu</small>
                    </div>
                </div>

            </div>

        </div>
    </section>



    <!-- ==========================================
         02. TRUST / ADVANTAGES
    =========================================== -->
    <section class="trust section-dark">

        <div class="container trust-grid">

            <article class="trust-card">

                <div class="trust-top">
                    <span class="material-symbols-outlined red">
                        precision_manufacturing
                    </span>
                    <code>PIL-01</code>
                </div>

                <h3>Thiết bị chuyên nghiệp</h3>

                <p>
                    Danh mục thiết bị hiệu ứng phục vụ sân khấu,
                    sự kiện trực tiếp và chương trình biểu diễn.
                </p>

            </article>

            <article class="trust-card">

                <div class="trust-top">
                    <span class="material-symbols-outlined orange">
                        analytics
                    </span>
                    <code>PIL-02</code>
                </div>

                <h3>Thông số minh bạch</h3>

                <p>
                    Cung cấp thông tin sản phẩm, thông số kỹ thuật
                    và tài liệu tham khảo để khách hàng lựa chọn.
                </p>

            </article>

            <article class="trust-card">

                <div class="trust-top">
                    <span class="material-symbols-outlined green">
                        support_agent
                    </span>
                    <code>PIL-03</code>
                </div>

                <h3>Tư vấn kỹ thuật</h3>

                <p>
                    Hỗ trợ trao đổi về cấu hình thiết bị,
                    khả năng kết nối và phương án triển khai.
                </p>

            </article>

            <article class="trust-card">

                <div class="trust-top">
                    <span class="material-symbols-outlined peach">
                        local_shipping
                    </span>
                    <code>PIL-04</code>
                </div>

                <h3>Hỗ trợ giao nhận</h3>

                <p>
                    Phối hợp kế hoạch giao nhận thiết bị
                    theo thời gian và địa điểm của dự án.
                </p>

            </article>

        </div>
    </section>


    <!-- ==========================================
         03. CATEGORIES
    =========================================== -->
    <section class="section categories" id="danh-muc">

        <div class="container">

            <div class="section-heading">

                <div>
                    <span class="eyebrow">
                        ⌁ STAGEFX EQUIPMENT COLLECTION
                    </span>

                    <h2>DANH MỤC THIẾT BỊ SÂN KHẤU</h2>
                </div>

                <p>
                    Khám phá các dòng thiết bị hiệu ứng
                    được phân loại theo nhu cầu sử dụng và giải pháp biểu diễn.
                </p>

            </div>


            <div class="category-grid">

                @if (categories != null && categories.Any())
                {
                    foreach (var category in categories)
                    {
                        var categoryType = getCategoryType(category.TenDanhMuc);

                        <article class="category-card"
                                 data-category="@category.MaDanhMuc">

                            <div class="category-image">
                                @if (!string.IsNullOrWhiteSpace(category.AnhDanhMuc))
                                {
                                    <img src="@Url.Content(category.AnhDanhMuc)"
                                         alt="@category.TenDanhMuc"
                                         loading="lazy"
                                         onerror="this.style.display='none';" />
                                }
                                else
                                {
                                    <div class="category-image-placeholder img-@categoryType"></div>
                                }

                                <span>@category.TenDanhMuc.ToUpper()</span>
                            </div>

                            <div class="category-body">

                                <h3>@category.TenDanhMuc</h3>

                                <p>
                                    @(string.IsNullOrWhiteSpace(category.MoTa)
                                        ? "Khám phá các thiết bị thuộc danh mục này."
                                        : category.MoTa)
                                </p>

                                <div class="card-bottom">

                                    <small>
                                        @category.SoLuongSanPham MODEL
                                    </small>

                                    <a class="text-button"
                                       href="@Url.Action(
                                           "Index",
                                           "Catalog",
                                           new { q = category.TenDanhMuc })">

                                        Xem thiết bị
                                        <span>→</span>

                                    </a>

                                </div>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="report-empty">
                        <span class="material-symbols-outlined">
                            category
                        </span>

                        <p>Hiện chưa có danh mục thiết bị.</p>
                    </div>
                }

            </div>

        </div>
    </section>


    <!-- ==========================================
         04. FEATURED PRODUCTS
    =========================================== -->
    <section class="featured section-dark"
             id="giai-phap-noi-bat">

        <div class="container">

            <div class="section-heading">

                <div>
                    <span class="eyebrow">
                        STAGEFX PRODUCT COLLECTION
                    </span>

                    <h2>THIẾT BỊ NỔI BẬT</h2>
                </div>

                <p>
                    Những dòng thiết bị dành cho đơn vị tổ chức sự kiện,
                    agency và nhà thầu sân khấu.
                </p>

                <a class="featured-catalog-link"
                   href="@Url.Action("Index", "Catalog")">

                    Xem toàn bộ thiết bị
                    <span>→</span>

                </a>

            </div>


            <!-- CATEGORY FILTER -->
            <div class="filters"
                 role="group"
                 aria-label="Lọc sản phẩm theo danh mục">

                <button class="filter active"
                        type="button"
                        data-filter="all">
                    Tất cả
                </button>

                @if (categories != null)
                {
                    foreach (var category in categories)
                    {
                        <button class="filter"
                                type="button"
                                data-filter="@category.MaDanhMuc">

                            @category.TenDanhMuc

                        </button>
                    }
                }

            </div>


            <!-- PRODUCT GRID -->
            <div class="product-grid" id="productGrid">

                @if (products != null && products.Any())
                {
                    foreach (var product in products)
                    {
                        var productType = getProductType(product.TenDanhMuc);

                        <article class="product-card"
                                 data-product-category="@product.MaDanhMuc">

                            <!-- PRODUCT IMAGE -->
                            <div class="product-visual product-@productType">

                                @if (!string.IsNullOrWhiteSpace(product.DuongDanAnh))
                                {
                                    <img src="@Url.Content(product.DuongDanAnh)"
                                         alt="@product.TenSanPham"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <span class="product-tag">
                                        STAGEFX PRO
                                    </span>
                                }

                            </div>


                            <!-- PRODUCT INFORMATION -->
                            <div class="product-info">

                                <small>
                                    @product.SKU
                                </small>

                                <h3>
                                    <a href="@Url.Action(
                                        "Index",
                                        "Catalog",
                                        new { q = product.SKU })">

                                        @product.TenSanPham

                                    </a>
                                </h3>

                                <p>
                                    @(string.IsNullOrWhiteSpace(product.ThongSoKyThuat)
                                        ? product.MoTaNgan
                                        : product.ThongSoKyThuat)
                                </p>


                                <!-- PRODUCT FOOTER -->
                                <div class="product-bottom">

                                    <strong>

                                        @if (product.GiaBan > 0)
                                        {
                                            @product.GiaBan.ToString("N0")
                                            @:₫
                                        }
                                        else
                                        {
                                            @:Liên hệ báo giá
                                        }

                                    </strong>

                                    <button class="add-button"
                                            type="button"
                                            data-product="@product.TenSanPham"
                                            aria-label="Yêu cầu báo giá sản phẩm">

                                        ＋

                                    </button>

                                </div>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="product-empty">
                        <span class="material-symbols-outlined">
                            inventory_2
                        </span>

                        <p>Hiện chưa có sản phẩm được đăng bán.</p>
                    </div>
                }

            </div>


            <p class="demo-note">
                * Giá bán và thông số được hiển thị theo dữ liệu sản phẩm
                trong hệ thống. Giá dự án có thể được xác nhận theo cấu hình
                và số lượng thiết bị thực tế.
            </p>

        </div>
    </section>


    <!-- ==========================================
         05. SOLUTIONS
    =========================================== -->
    <section class="solutions section" id="giai-phap">

        <div class="container solution-layout">

            <div class="solution-art">

                <div class="art-label">
                    STAGEFX / FIELD OPERATIONS
                </div>

                <div class="art-caption">

                    <strong>
                        PRECISION IN EVERY SHOW
                    </strong>

                    <span>
                        DMX512 • TOURING • PROFESSIONAL
                    </span>

                </div>

            </div>


            <div class="solution-copy">

                <span class="eyebrow">
                    PROFESSIONAL STAGE SOLUTIONS
                </span>

                <h2>
                    GIẢI PHÁP HIỆU ỨNG
                    CHO MỌI QUY MÔ SỰ KIỆN
                </h2>

                <p>
                    STAGEFX PRO đồng hành cùng doanh nghiệp trong việc
                    lựa chọn thiết bị, tham khảo cấu hình điều khiển,
                    lập kế hoạch giao nhận và phối hợp kỹ thuật cho dự án.
                </p>

                <ul>

                    <li>
                        <span>✓</span>
                        Tư vấn cấu hình theo quy mô sân khấu
                    </li>

                    <li>
                        <span>✓</span>
                        Hỗ trợ tích hợp hệ thống DMX512
                    </li>

                    <li>
                        <span>✓</span>
                        Lập kế hoạch giao nhận thiết bị
                    </li>

                    <li>
                        <span>✓</span>
                        Tài liệu kỹ thuật và checklist nghiệm thu
                    </li>

                </ul>

                <button class="btn btn-primary"
                        type="button"
                        data-scroll="#tu-van">

                    Trao đổi dự án
                    <span>→</span>

                </button>

            </div>

        </div>
    </section>


    <!-- ==========================================
         06. PARTNERS / TESTIMONIALS
    =========================================== -->
    <section class="testimonials section-dark" id="doi-tac">

        <div class="container">

            <div class="section-heading">

                <div>
                    <span class="eyebrow">
                        PARTNERS & CUSTOMER EXPERIENCE
                    </span>

                    <h2>ĐỒNG HÀNH CÙNG ĐỐI TÁC</h2>
                </div>

                <p>
                    Hướng đến quy trình hợp tác rõ ràng,
                    hỗ trợ kỹ thuật và triển khai theo kế hoạch.
                </p>

            </div>


            <div class="quote-grid">

                <blockquote>

                    <div class="stars">★★★★★</div>

                    <p>
                        “Quy trình tư vấn rõ ràng, thông tin thiết bị
                        được trình bày đầy đủ để đội ngũ kỹ thuật
                        tham khảo và lên phương án sân khấu.”
                    </p>

                    <footer>

                        <span class="quote-avatar">EA</span>

                        <span>
                            <b>Event Agency</b>
                            <small>Đơn vị tổ chức sự kiện</small>
                        </span>

                    </footer>

                </blockquote>


                <blockquote>

                    <div class="stars">★★★★★</div>

                    <p>
                        “Việc phối hợp kế hoạch giao nhận và kiểm tra
                        thiết bị giúp đội ngũ sản xuất chủ động hơn
                        trong quá trình chuẩn bị chương trình.”
                    </p>

                    <footer>

                        <span class="quote-avatar">SP</span>

                        <span>
                            <b>Stage Production</b>
                            <small>Đội ngũ sản xuất sân khấu</small>
                        </span>

                    </footer>

                </blockquote>


                <blockquote>

                    <div class="stars">★★★★★</div>

                    <p>
                        “Được hỗ trợ trao đổi về cấu hình thiết bị
                        và phương án kỹ thuật phù hợp với yêu cầu
                        của chương trình.”
                    </p>

                    <footer>

                        <span class="quote-avatar">LE</span>

                        <span>
                            <b>Live Event Team</b>
                            <small>Đơn vị sản xuất sự kiện</small>
                        </span>

                    </footer>

                </blockquote>

            </div>

            <p class="demo-note">
                * Nội dung nhận xét hiện là dữ liệu minh họa giao diện.
            </p>

        </div>
    </section>


    <!-- ==========================================
         07. B2B CONSULTATION
    =========================================== -->
    <section class="consult section" id="tu-van">

        <div class="container consult-layout">

            <!-- CONSULTATION INFORMATION -->
            <div class="consult-copy">

                <span class="eyebrow">
                    B2B PROJECT CONSULTATION
                </span>

                <h2>
                    BẮT ĐẦU DỰ ÁN
                    SÂN KHẤU CỦA BẠN
                </h2>

                <p>
                    Hãy gửi thông tin cơ bản về nhu cầu của doanh nghiệp.
                    Đội ngũ STAGEFX PRO sẽ tiếp nhận và trao đổi
                    phương án thiết bị phù hợp với dự án.
                </p>


                <div class="contact-line">

                    <span class="material-symbols-outlined">
                        call
                    </span>

                    <div>

                        <small>
                            HOTLINE TƯ VẤN
                        </small>

                        <a href="tel:0988683977">
                            0912 877 344
                        </a>

                    </div>

                </div>


                <div class="contact-line">

                    <span class="material-symbols-outlined">
                        support_agent
                    </span>

                    <div>

                        <small>
                            HỖ TRỢ KHÁCH HÀNG
                        </small>

                        <span>
                            Tư vấn thiết bị và giải pháp B2B
                        </span>

                    </div>

                </div>


                <p class="response-note">
                    Thông tin yêu cầu sẽ được tiếp nhận để đội ngũ
                    phụ trách liên hệ trao đổi.
                </p>

            </div>


            <!-- CONSULTATION FORM -->
            <form id="consultForm"
                  class="consult-form"
                  action="@Url.Action("GuiYeuCauTuVan", "Home")"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="form-group">

                    <label for="companyName">
                        Tên công ty / người liên hệ
                    </label>

                    <input type="text"
                           id="companyName"
                           name="CompanyName"
                           placeholder="Nhập tên công ty hoặc người liên hệ"
                           value="@(Session["HoTen"] ?? "")"
                           maxlength="200"
                           required />

                </div>


                <div class="form-group">

                    <label for="email">
                        Email liên hệ
                    </label>

                    <input type="email"
                           id="email"
                           name="Email"
                           placeholder="example@email.com"
                           value="@(Session["Email"] ?? "")"
                           maxlength="200"
                           required />

                </div>


                <div class="form-group">

                    <label for="phone">
                        Số điện thoại
                    </label>

                    <input type="tel"
                           id="phone"
                           name="Phone"
                           placeholder="Nhập số điện thoại"
                           maxlength="20" />

                </div>


                <div class="form-group">

                    <label for="scale">
                        Quy mô sự kiện
                    </label>

                    <select id="scale" name="Scale">

                        <option value="">
                            Chọn quy mô sự kiện
                        </option>

                        <option value="Dưới 100 người">
                            Dưới 100 người
                        </option>

                        <option value="100 - 500 người">
                            100 - 500 người
                        </option>

                        <option value="500 - 1000 người">
                            500 - 1000 người
                        </option>

                        <option value="Trên 1000 người">
                            Trên 1000 người
                        </option>

                    </select>

                </div>
                <div class="form-group">
                    <label for="consultContent">Nội dung yêu cầu tư vấn</label>
                    <textarea id="consultContent"
                              name="Content"
                              rows="5"
                              maxlength="1000"
                              placeholder="Mô tả nhu cầu, loại thiết bị, hiệu ứng hoặc yêu cầu của sự kiện..."></textarea>
                </div>


                <!-- PRODUCT SELECTED FROM FEATURED SECTION -->
                <input type="hidden"
                       id="requestedProduct"
                       name="RequestedProduct"
                       value="" />


                <button type="submit"
                        class="form-submit btn btn-primary">

                    Gửi yêu cầu tư vấn
                    <span>→</span>

                </button>


                <p id="formMessage"
                   class="form-message"
                   role="status"
                   aria-live="polite">
                </p>


                <p class="privacy-note">
                    Thông tin được sử dụng cho mục đích tiếp nhận
                    và tư vấn yêu cầu của khách hàng.
                </p>

            </form>

        </div>
    </section>

</main>


<!-- ==========================================
     PAGE STYLES
=========================================== -->
@section styles {

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/home.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/home-links.css")" />

}


<!-- ==========================================
     PAGE SCRIPTS
=========================================== -->
@section scripts {

    <script src="@Url.Content("~/Scripts/home.js")" defer></script>

}
